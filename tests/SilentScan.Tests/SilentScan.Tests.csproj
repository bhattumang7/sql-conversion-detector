<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- xUnit convention is Method_Scenario_Expectation; CA1707 fights that idiom in test projects. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SilentScan.Core/SilentScan.Core.csproj" />
    <ProjectReference Include="../../src/SilentScan.Cli/SilentScan.Cli.csproj" />
    <ProjectReference Include="../../src/SilentScan.Live/SilentScan.Live.csproj" />
    <ProjectReference Include="../../src/SilentScan.Verify/SilentScan.Verify.csproj" />
    <ProjectReference Include="../../src/SilentScan.Bench/SilentScan.Bench.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="fixtures/**/*.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
